rules_version = '2';

// CAFIVER TI — Reglas de seguridad de Cloud Firestore (PROPUESTA, no desplegada).
//
// ANTES DE PUBLICAR:
//  1. Las reglas anteriores están guardadas en docs/reglas-anteriores.txt para poder revertir. Compáralas con la consola.
//  2. El bloque final replica tus reglas actuales para todo lo que NO sea nuevo (docs/reglas-anteriores.txt). Se endurecerá
//     en una etapa posterior, con autorización, para no romper el inventario.
//  3. Publica primero en un proyecto de pruebas o con el emulador (ver docs/PLATAFORMA.md).
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Funciones auxiliares ---------- */
    function firmado() { return request.auth != null && request.auth.token.email != null; }
    function correo() { return request.auth.token.email.lower(); }
    function rutaUsuario() { return /databases/$(database)/documents/usuarios_ti/$(correo()); }
    function hayRegistro() { return firmado() && exists(rutaUsuario()); }
    function activo() { return hayRegistro() && get(rutaUsuario()).data.activo == true; }
    function tieneRol(r) { return activo() && (r in get(rutaUsuario()).data.roles); }
    // El Gerente de TI reúne los permisos del Administrador y del Director; el Consultor los del Responsable de proceso (más atender tickets asignados).
    function esGerente() { return tieneRol('gerente'); }
    function esAdmin() { return tieneRol('administrador') || tieneRol('gerente'); }
    function esDirector() { return tieneRol('director') || tieneRol('gerente'); }
    function esConsultor() { return tieneRol('consultor'); }
    function esResp() { return tieneRol('resp_proceso') || tieneRol('consultor'); }
    function esTecnico() { return tieneRol('tecnico'); }
    // Administradores que pueden crear su propio registro la primera vez. Deben coincidir con TI.BOOTSTRAP_ADMINS en js/ti-core.js.
    function esArranque() { return firmado() && correo() in ['ramaya@cafiver.com.mx']; }
    function rolesValidos(l) { return l is list && l.size() <= 5 && l.hasOnly(['gerente', 'consultor', 'director', 'administrador', 'resp_proceso', 'tecnico', 'solicitante']); }

    /* ---------- Usuarios y roles ---------- */
    match /usuarios_ti/{id} {
      // Cada quien puede leer su propio registro (para conocer su rol); los usuarios activos leen el directorio.
      allow read: if firmado() && (id == correo() || activo());
      allow create: if firmado() && request.resource.data.email == id && rolesValidos(request.resource.data.roles)
                    && request.resource.data.activo is bool
                    && (esAdmin() || (esArranque() && id == correo() && request.resource.data.roles == ['gerente'] && request.resource.data.activo == true));
      allow update: if esAdmin() && request.resource.data.email == id && rolesValidos(request.resource.data.roles) && request.resource.data.activo is bool;
      allow delete: if false;
    }

    /* ---------- Configuración (folios y mesa de ayuda) ---------- */
    // Folios: ti_config/contadores {procesos, tickets}. Los procesos los incrementa el administrador o un responsable (el catálogo
    // reserva varios a la vez); los tickets los incrementa cualquier usuario activo, de uno en uno.
    function ctr() { return request.resource.data; }
    function ctrAntes(k) { return resource.data.get(k, 0); }
    match /ti_config/{doc} {
      allow read: if activo();
      allow create: if (doc == 'contadores'
                        && ((ctr().keys().hasOnly(['procesos']) && ctr().procesos is int && ctr().procesos >= 1 && (esAdmin() || esResp()))
                         || (ctr().keys().hasOnly(['tickets']) && ctr().tickets == 1 && activo())))
                    || (doc == 'tickets' && esAdmin() && configTicketsValida());
      allow update: if (doc == 'contadores' && ctr().keys().hasOnly(['procesos', 'tickets'])
                        && ((ctr().get('procesos', 0) > ctrAntes('procesos') && ctr().get('tickets', 0) == ctrAntes('tickets') && (esAdmin() || esResp()))
                         || (ctr().get('tickets', 0) == ctrAntes('tickets') + 1 && ctr().get('procesos', 0) == ctrAntes('procesos') && activo())))
                    || (doc == 'tickets' && esAdmin() && configTicketsValida());
      allow delete: if false;
    }
    function configTicketsValida() {
      return request.resource.data.keys().hasOnly(['categorias', 'sla', 'horario', 'ventanaReaperturaDias', 'alertaPct', 'actualizadoPor', 'actualizadoEn'])
          && request.resource.data.categorias is list && request.resource.data.categorias.size() > 0 && request.resource.data.categorias.size() <= 60
          && request.resource.data.sla is map
          && request.resource.data.ventanaReaperturaDias is number && request.resource.data.alertaPct is number
          && request.resource.data.actualizadoPor == correo() && request.resource.data.actualizadoEn == request.time;
    }

    /* ---------- Resumen del inventario (calculado a mano por Director o Administrador) ---------- */
    match /ti_resumenes/{id} {
      allow read: if esAdmin() || esDirector();
      allow create, update: if (esAdmin() || esDirector()) && id == 'inventario' && request.resource.data.calculadoPor == correo()
                            && request.resource.data.keys().hasOnly(['calculadoEn', 'calculadoMs', 'calculadoPor', 'equiposLeidos', 'datos'])
                            && request.resource.data.calculadoEn == request.time;
      allow delete: if false;
    }

    /* ---------- Auditoría: solo se crea; nadie edita ni borra ---------- */
    match /ti_auditoria/{id} {
      allow read: if esAdmin() || esDirector();
      allow create: if activo() && request.resource.data.usuario == correo()
                    && request.resource.data.keys().hasOnly(['fecha', 'usuario', 'accion', 'tipoRegistro', 'registroId', 'resultado', 'detalle', 'motivo'])
                    && request.resource.data.fecha == request.time;
      allow update, delete: if false;
    }

    /* ---------- Procesos y procedimientos ---------- */
    function esPropietario(p) { return p.responsable == correo() || p.creadoPor == correo() || correo() in p.participantes; }
    function editorDe(p) { return esAdmin() || (esResp() && esPropietario(p)); }
    function rutaProceso(id) { return /databases/$(database)/documents/ti_procesos/$(id); }
    function publicado(p) { return p.versionPublicada is int && p.versionPublicada > 0; }
    function puedeLeerProceso(p) { return esAdmin() || esDirector() || esResp() || (esTecnico() && publicado(p)); }

    match /ti_procesos/{id} {
      allow read: if puedeLeerProceso(resource.data);
      // Crear: el estado de la cabecera debe coincidir con el de la versión 1, creada en el mismo lote.
      allow create: if (esAdmin() || esResp()) && request.resource.data.creadoPor == correo()
                    && request.resource.data.estado == 'borrador' && request.resource.data.versionTrabajo == 1 && request.resource.data.versionPublicada == null
                    && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 200
                    && request.resource.data.responsable is string && request.resource.data.participantes is list
                    && getAfter(/databases/$(database)/documents/ti_procesos/$(id)/versiones/1).data.estado == 'borrador';
      // Actualizar: quien edita, o Director/Administrador para las transiciones. En todos los casos el estado de la cabecera
      // debe ser exactamente el de la versión de trabajo, y la versión vigente debe estar publicada (así no se puede
      // "publicar" tocando solo la cabecera).
      allow update: if (editorDe(resource.data) || esDirector() || esAdmin())
                    && request.resource.data.codigo == resource.data.codigo && request.resource.data.creadoPor == resource.data.creadoPor
                    && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 200
                    && getAfter(/databases/$(database)/documents/ti_procesos/$(id)/versiones/$(string(request.resource.data.versionTrabajo))).data.estado == request.resource.data.estado
                    && (request.resource.data.versionPublicada == null
                        || getAfter(/databases/$(database)/documents/ti_procesos/$(id)/versiones/$(string(request.resource.data.versionPublicada))).data.estado in ['publicado', 'en_revision_periodica']);
      allow delete: if false;

      match /versiones/{n} {
        function version() { return resource.data; }
        function nueva() { return request.resource.data; }
        function padre() { return get(rutaProceso(id)).data; }
        function lecturaVersion() { return esAdmin() || esDirector() || esResp() || (esTecnico() && resource.data.estado in ['publicado', 'en_revision_periodica']); }
        function editor() { return editorDe(padre()); }
        // Al crear, la cabecera puede estar en el mismo lote (proceso nuevo): se lee su estado posterior.
        function editorAlCrear() { return editorDe(getAfter(rutaProceso(id)).data); }
        function revisor() { return esDirector() || esAdmin(); }
        function inmutables() { return nueva().numero == version().numero && nueva().creadoPor == version().creadoPor; }
        function transicion() {
          return
            (version().estado == 'borrador'              && nueva().estado == 'en_revision'           && editor())
         || (version().estado == 'en_revision'           && nueva().estado in ['pendiente_aprobacion', 'borrador'] && editor())
         || (version().estado == 'pendiente_aprobacion'  && nueva().estado == 'aprobado'              && esDirector()
                                                           && !(correo() in version().editores) && nueva().aprobacion.por == correo())
         || (version().estado == 'pendiente_aprobacion'  && nueva().estado == 'borrador'              && esDirector())
         || (version().estado == 'aprobado'              && nueva().estado == 'publicado'             && revisor())
         || (version().estado == 'publicado'             && nueva().estado == 'en_revision_periodica' && editor())
         || (version().estado == 'en_revision_periodica' && nueva().estado == 'publicado'             && revisor())
         || (version().estado in ['publicado', 'en_revision_periodica'] && nueva().estado == 'reemplazada' && revisor())
         || (version().estado in ['borrador', 'aprobado', 'publicado', 'en_revision_periodica'] && nueva().estado == 'obsoleto' && revisor());
        }

        allow read: if lecturaVersion();
        // Una versión nueva siempre nace como borrador, con quien la crea como primer editor.
        allow create: if editorAlCrear() && nueva().estado == 'borrador' && nueva().numero == int(n)
                      && nueva().creadoPor == correo() && nueva().editores == [correo()];
        allow update: if inmutables() && (
              // Editar un borrador: cambia el contenido y se agrega al editor; el estado no cambia.
              (version().estado == 'borrador' && nueva().estado == 'borrador' && editor() && correo() in nueva().editores)
              // Cualquier otro cambio es una transición permitida y el contenido queda intacto (versiones inmutables).
           || (nueva().contenido == version().contenido && nueva().editores == version().editores && transicion()));
        allow delete: if false;
      }

      match /historial/{h} {
        allow read: if esAdmin() || esDirector() || esResp();
        allow create: if (editorDe(getAfter(rutaProceso(id)).data) || esDirector() || esAdmin()) && request.resource.data.usuario == correo();
        allow update, delete: if false;
      }
    }

    /* ---------- Mesa de ayuda ---------- */
    // Administrador, Director y Técnico ven todos los tickets; los demás solo los que crearon. El ticket guarda únicamente el ID
    // del equipo afectado. Las transiciones de estado válidas están en la tabla de abajo (la misma que ti-logic.js).
    function equipoTI() { return esAdmin() || esDirector() || esTecnico(); }
    function rutaTicket(id) { return /databases/$(database)/documents/ti_tickets/$(id); }
    function tk() { return resource.data; }
    function tkNuevo() { return request.resource.data; }
    function cambia() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function soyElSolicitante() { return tk().solicitanteEmail == correo(); }
    function ventanaDias() { return exists(/databases/$(database)/documents/ti_config/tickets) ? get(/databases/$(database)/documents/ti_config/tickets).data.ventanaReaperturaDias : 5; }
    // cerradoMs puede existir con valor null (ticket resuelto aún no cerrado): se usa resueltoMs en ese caso.
    function refCierre() { return tk().cerradoMs != null ? tk().cerradoMs : tk().resueltoMs; }
    function dentroDeVentana() { return refCierre() is int && request.time.toMillis() - refCierre() <= ventanaDias() * 86400000; }
    function transicionValida(a, b) {
      return (a == 'nuevo' && b in ['asignado', 'cancelado'])
          || (a == 'asignado' && b in ['en_atencion', 'cancelado'])
          || (a == 'en_atencion' && b in ['espera_usuario', 'espera_tercero', 'resuelto', 'cancelado'])
          || (a in ['espera_usuario', 'espera_tercero'] && b in ['en_atencion', 'cancelado'])
          || (a == 'resuelto' && b in ['cerrado', 'en_atencion'])
          || (a == 'cerrado' && b == 'en_atencion');
    }
    function camposFijos() {
      return !cambia().hasAny(['codigo', 'solicitanteEmail', 'creadoMs', 'creadoEn', 'titulo', 'descripcion', 'tipo', 'categoria', 'evidencias', 'activoId', 'departamento', 'sistema']);
    }
    function estadoOk() { return tkNuevo().estado == tk().estado || transicionValida(tk().estado, tkNuevo().estado); }
    // Quien atiende: el administrador siempre; el técnico solo si el ticket es suyo o lo toma (sin responsable); el director solo asigna y cambia prioridad.
    function atiendeTI() {
      return esAdmin()
          || ((esTecnico() || esConsultor()) && (tk().responsable == correo() || (tk().responsable == null && tkNuevo().responsable == correo() && tk().estado == 'nuevo')))
          || (esDirector() && cambia().hasOnly(['responsable', 'estado', 'impacto', 'urgencia', 'prioridad', 'actualizadoEn']) && (tkNuevo().estado == tk().estado || (tk().estado == 'nuevo' && tkNuevo().estado == 'asignado')));
    }
    function solicitanteActua() {
      return soyElSolicitante() && (
          (tk().estado == 'nuevo' && tkNuevo().estado == 'cancelado' && cambia().hasOnly(['estado', 'esperas', 'actualizadoEn']))
       || (tk().estado == 'espera_usuario' && tkNuevo().estado == 'en_atencion' && cambia().hasOnly(['estado', 'esperas', 'actualizadoEn']))
       || (tk().estado == 'resuelto' && tkNuevo().estado == 'cerrado' && cambia().hasOnly(['estado', 'cerradoMs', 'confirmacion', 'actualizadoEn']))
       || (tk().estado in ['resuelto', 'cerrado'] && tkNuevo().estado == 'en_atencion' && dentroDeVentana()
           && cambia().hasOnly(['estado', 'resueltoMs', 'cerradoMs', 'confirmacion', 'reaperturas', 'actualizadoEn']) && tkNuevo().reaperturas == tk().get('reaperturas', 0) + 1));
    }

    match /ti_tickets/{id} {
      // El Consultor lee los tickets que tiene asignados, los que creó y los nuevos sin responsable (para tomarlos).
      allow read: if equipoTI() || (activo() && soyElSolicitante()) || (esConsultor() && (tk().responsable == correo() || (tk().responsable == null && tk().estado == 'nuevo')));
      allow create: if activo() && tkNuevo().solicitanteEmail == correo() && tkNuevo().estado == 'nuevo' && tkNuevo().responsable == null
                    && tkNuevo().codigo == id && tkNuevo().tipo in ['incidente', 'solicitud'] && tkNuevo().impacto in ['alto', 'medio', 'bajo'] && tkNuevo().urgencia in ['alta', 'media', 'baja']
                    && tkNuevo().prioridad in ['critica', 'alta', 'media', 'baja']
                    && tkNuevo().titulo is string && tkNuevo().titulo.size() > 0 && tkNuevo().titulo.size() <= 200
                    && tkNuevo().descripcion is string && tkNuevo().descripcion.size() > 0 && tkNuevo().descripcion.size() <= 5000
                    && tkNuevo().esperas == [] && tkNuevo().reaperturas == 0 && tkNuevo().escaladoNivel == 0
                    && tkNuevo().creadoMs is int && math.abs(tkNuevo().creadoMs - request.time.toMillis()) < 600000 && tkNuevo().creadoEn == request.time;
      allow update: if camposFijos() && estadoOk() && (
                    // El administrador y el equipo técnico, con las restricciones de arriba. Cancelar un ticket ajeno es solo del administrador.
                    ((equipoTI() || esConsultor()) && atiendeTI() && (tkNuevo().estado != 'cancelado' || tk().estado == tkNuevo().estado || esAdmin()))
                    // Primera respuesta pública (la registra el comentario de TI).
                 || ((equipoTI() || (esConsultor() && tk().responsable == correo())) && tk().primeraRespuestaMs == null && cambia().hasOnly(['primeraRespuestaMs', 'actualizadoEn']))
                 || solicitanteActua());
      allow delete: if false;

      match /comentarios/{c} {
        function padreT() { return get(rutaTicket(id)).data; }
        allow read: if equipoTI() || (esConsultor() && (padreT().responsable == correo() || padreT().responsable == null)) || (activo() && padreT().solicitanteEmail == correo() && resource.data.interno == false);
        allow create: if activo() && request.resource.data.autor == correo() && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 2000
                      && request.resource.data.interno is bool && request.resource.data.fecha == request.time
                      && (equipoTI() || (esConsultor() && getAfter(rutaTicket(id)).data.responsable == correo()) || (getAfter(rutaTicket(id)).data.solicitanteEmail == correo() && request.resource.data.interno == false));
        allow update, delete: if false;
      }
      match /historial/{h} {
        allow read: if equipoTI() || (esConsultor() && (get(rutaTicket(id)).data.responsable == correo()));
        allow create: if activo() && request.resource.data.usuario == correo() && request.resource.data.fecha == request.time;
        allow update, delete: if false;
      }
    }

    /* ---------- INVENTARIO y todo lo que no es nuevo (transitorio) ----------
       Idéntico a las reglas anteriores (docs/reglas-anteriores.txt): cualquier usuario autenticado lee y escribe,
       EXCEPTO en las colecciones nuevas de la plataforma (ti_* y usuarios_ti), que quedan protegidas por rol.
       Así el inventario no cambia aunque existiera alguna colección no detectada. Se endurecerá en una etapa
       posterior, con autorización. */
    match /{col}/{doc=**} {
      allow read, write: if request.auth != null && !col.matches('ti_.*|usuarios_ti');
    }
  }
}
